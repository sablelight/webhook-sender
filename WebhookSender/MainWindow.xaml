<Window x:Class="WebhookSender.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Webhook Sender" Height="920" Width="1480"
        MinHeight="700" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        SnapsToDevicePixels="True" UseLayoutRounding="True"
        Background="#2E2E33" TextOptions.TextFormattingMode="Display"
        FontFamily="Whitney, Helvetica, Segoe UI, sans-serif">

    <Window.Resources>
        <Color x:Key="NavBg">#1E1F22</Color>
        <Color x:Key="EditorBg">#1E1F22</Color>
        <Color x:Key="PreviewBg">#313338</Color>
        <Color x:Key="CardBg">#2B2D31</Color>
        <Color x:Key="InputBg">#333338</Color>
        <Color x:Key="EmbedBg">#37373D</Color>
        <Color x:Key="Fg">#DBDEE1</Color>
        <Color x:Key="Fg2">#EBEBED</Color>
        <Color x:Key="FgMuted">#949BA4</Color>
        <Color x:Key="Timestamp">#949BA4</Color>
        <Color x:Key="Blurple">#5865F2</Color>
        <Color x:Key="Green">#23A55A</Color>
        <Color x:Key="Danger">#DA373C</Color>
        <Color x:Key="Border">#434349</Color>
        <Color x:Key="Divider">#27292D</Color>

        <Style x:Key="Tb" TargetType="TextBox">
            <Setter Property="Background" Value="#333338"/>
            <Setter Property="Foreground" Value="#DBDEE1"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="CaretBrush" Value="#DBDEE1"/>
            <Setter Property="MinHeight" Value="36"/>
        </Style>

        <Style x:Key="SiteBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#DBDEE1"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="10,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DiscordExpander" TargetType="Expander">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#949BA4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition x:Name="ContentRow" Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border x:Name="Hdr" Background="Transparent" Padding="0" Cursor="Hand">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="Chevron" Text="▶" Foreground="#949BA4" FontSize="10" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="ContentBorder" Grid.Row="1" Background="Transparent" Padding="0,8,0,0" Visibility="Collapsed">
                                <ContentPresenter x:Name="Content"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ContentBorder" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Chevron" Property="Text" Value="▼"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ TOP NAV (48px, #1E1F22) ═══ -->
        <Border Grid.Row="0" Background="#1E1F22" BorderThickness="0,0,0,2" BorderBrush="#1E1F22" Padding="16,0">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="32" Height="32" CornerRadius="6" Background="#5865F2" Margin="0,0,12,0">
                        <TextBlock Text="WS" Foreground="White" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border CornerRadius="8" Padding="6,4" Cursor="Hand" Background="Transparent">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="28" Height="28" CornerRadius="14" Background="#5865F2">
                                <TextBlock Text="W" Foreground="White" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Webhook" Foreground="#EBEBED" FontSize="14" Margin="6,0,0,0" VerticalAlignment="Center" FontWeight="Medium"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Clear All" Style="{StaticResource SiteBtn}"
                            Background="#97979F1F" Foreground="#EBEBED"
                            BorderBrush="#97979F0A" BorderThickness="1"
                            Click="ClearLog_Click"/>
                    <Button x:Name="SendBtn" Content="Send" Style="{StaticResource SiteBtn}"
                            Background="#5865F2" Foreground="White" FontWeight="SemiBold"
                            Padding="16,5" Click="SendAll_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═══ MAIN 2-COLUMN AREA ═══ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="520"/>
                <ColumnDefinition Width="2"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: Editor Panel (520px fixed, matching website embed max-width) -->
            <Border Grid.Column="0" Background="#1E1F22">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Editor Header -->
                    <Border Grid.Row="0" Padding="12,10" Background="#1E1F22">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="MESSAGES" Foreground="#949BA4" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Button Content="+ Add Webhook" Style="{StaticResource SiteBtn}"
                                    Background="#97979F1F" Foreground="#EBEBED"
                                    BorderBrush="#97979F0A" BorderThickness="1"
                                    Margin="12,0,0,0" FontSize="12" Padding="10,3"/>
                            <Button Content="+ Add Message" Style="{StaticResource SiteBtn}"
                                    Background="#5865F2" Foreground="White" FontSize="12"
                                    Padding="10,3" Margin="6,0,0,0" FontWeight="SemiBold"
                                    Click="AddMsg_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- Message List (scrollable) -->
                    <ScrollViewer x:Name="MsgScroll" Grid.Row="1" Background="#1E1F22">
                        <StackPanel x:Name="MsgPanel" Margin="8,0,8,8"/>
                    </ScrollViewer>

                    <!-- Bottom Bar (webhook + send) -->
                    <Border Grid.Row="2" Background="#1E1F22" BorderThickness="0,1,0,0" BorderBrush="#27292D" Padding="12,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="WebhookBox" Style="{StaticResource Tb}" Grid.Column="0"/>
                                <TextBox x:Name="UsernameBox" Style="{StaticResource Tb}" Grid.Column="2"/>
                            </Grid>
                            <DockPanel>
                                <Button Content="Send Messages" Style="{StaticResource SiteBtn}"
                                        Background="#5865F2" Foreground="White" FontWeight="SemiBold"
                                        Padding="16,7" FontSize="14"
                                        DockPanel.Dock="Right" Click="SendAll_Click"/>
                                <TextBox x:Name="StatusBox" Background="Transparent" Foreground="#949BA4"
                                         BorderThickness="0" FontFamily="Consolas" FontSize="11"
                                         IsReadOnly="True" VerticalAlignment="Center" Text="Ready"
                                         Margin="0,0,8,0"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- DIVIDER -->
            <Border Grid.Column="1" Background="#1E1F22"/>

            <!-- RIGHT: Preview Panel -->
            <Border Grid.Column="2" Background="#313338">
                <ScrollViewer Background="#313338" Padding="16,12">
                    <StackPanel x:Name="PreviewPanel"/>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
