<Application x:Class="WebhookSender.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Colors -->
            <Color x:Key="Bg">#313338</Color>
            <Color x:Key="SectionBg">#2B2D31</Color>
            <Color x:Key="CardBg">#232428</Color>
            <Color x:Key="InputBg">#1E1F22</Color>
            <Color x:Key="Fg">#DBDEE1</Color>
            <Color x:Key="FgMuted">#949BA4</Color>
            <Color x:Key="Accent">#5865F2</Color>
            <Color x:Key="AccentHover">#4752C4</Color>
            <Color x:Key="Success">#23A55A</Color>
            <Color x:Key="Danger">#DA373C</Color>
            <Color x:Key="Border">#3F4147</Color>

            <!-- Brushes -->
            <SolidColorBrush x:Key="BgBrush" Color="{StaticResource Bg}" />
            <SolidColorBrush x:Key="SectionBgBrush" Color="{StaticResource SectionBg}" />
            <SolidColorBrush x:Key="CardBgBrush" Color="{StaticResource CardBg}" />
            <SolidColorBrush x:Key="InputBgBrush" Color="{StaticResource InputBg}" />
            <SolidColorBrush x:Key="FgBrush" Color="{StaticResource Fg}" />
            <SolidColorBrush x:Key="FgMutedBrush" Color="{StaticResource FgMuted}" />
            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}" />
            <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Success}" />
            <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource Danger}" />
            <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource Border}" />

            <!-- Styles -->
            <Style TargetType="TextBox" x:Key="DarkInput">
                <Setter Property="Background" Value="{StaticResource InputBgBrush}" />
                <Setter Property="Foreground" Value="{StaticResource FgBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Padding" Value="8,6" />
                <Setter Property="CaretBrush" Value="{StaticResource FgBrush}" />
            </Style>

            <Style TargetType="Button" x:Key="ActionBtn">
                <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Padding" Value="14,6" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="ListBoxItem" x:Key="MsgListItem">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource FgBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="8,6" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="8,6" Margin="2,1">
                                <ContentPresenter />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#3F4147" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
